[server]
host = "0.0.0.0"
port = 8000
data_dir = "./data"
# The address sysops reach the hub at. Used in claim links and in the config
# files they hand out; without it the hub guesses from each request.
# public_url = "https://hub.example.com"

[hub]
bbs_name = "Nova Hub"
bbs_index = "01"
# The hub's own location lines in generated nodelists. The hub is node
# bbs_index of every league it runs, but it is not a client, so its entry comes
# from here rather than from the database. Its FidoNet address differs per
# league and lives on the league instead (hub_fidonet_address).
city = "Brisbane"
state = "QLD"
country = "AUS"

[processing]
poll_interval = 60
# Days of bulk content to keep. Dosemu transcripts and the bodies of generated
# files older than this are dropped; the run rows, their counts and their
# per-league attribution are kept. 0 disables the pass entirely.
retention_days = 30
retention_batch_size = 500
# Whether a missing sequence number raises an alert at all.
#
# Off by default, and measured rather than cautious: both games burn a sequence
# number at each game-day rollover, and across eight months of production data
# every busy route showed exactly one lone missing number per active day -- 232
# days of 239 on one route, 237 of 241 on another. A lone gap is the game working
# normally, and it cannot be told apart from a packet that really went missing.
# Enabled, this fires about three times a day and every one is the rollover.
#
# Gaps are still detected and recorded either way. What the movements view offers
# instead is the games' own account of what they exchanged, for an admin who
# knows what their league should look like. Set true to get the alerts back.
sequence_alerts_enabled = false
# How recent a sequence gap must be to raise an alert, when they are enabled. A missing packet is only
# actionable while it might still be recovered -- someone reports an attach went
# missing in transit and the hub can name the number that never arrived. Older
# gaps are still detected and still counted; they just do not raise an alarm
# nobody can act on, which keeps a genuine one from being buried. 0 disables the
# bound and alerts on everything, including the whole back catalogue.
sequence_alert_max_age_days = 14

[dosemu]
dosemu_path = "/usr/bin/dosemu"
config_dir = "./dosemu_configs"
capture_output = true
timeout = 300

# Per-league DOSEMU configuration
# Format: [dosemu.<league_number>.<game_type>]
# Directories will be: ./data/dosemu/<league_number>/<game_type>/inbound/
#                      ./data/dosemu/<league_number>/<game_type>/outbound/

# NOTE: every directory component of these paths must be valid DOS 8.3 (max 8
# characters, no spaces). The games resolve inbound_folder as an absolute path
# through 16-bit path handling that cannot traverse a longer name -- and they fail
# *silently*: the run completes, exits 0, prints every progress marker, and simply
# ingests nothing. "bre_555" is 7 characters and fine; "bre_555_node02" would not be.
#
# /DETAILED on processing_command is what puts the per-item
# "Type: <x> <src>-> <dst>" lines in the transcript. Without it the run is
# identical but what moved between nodes is invisible.
#
# completion_marker is optional. When set, a run whose transcript never reaches
# this string is recorded as failed even if dosemu exited 0 -- which catches the
# game dying part-way through. Leave it unset to key on the exit code alone.
[dosemu.555.bre]
game_folder = "/home/novahub/.dosemu/drive_c/bbs/doors/bre_555"
game_dos_path = "C:\\bbs\\doors\\bre_555"
inbound_folder = "/home/novahub/.dosemu/drive_c/bbs/doors/bre_555/INBOUND"
outbound_folder = "/home/novahub/.dosemu/drive_c/bbs/doors/bre_555/OUTBOUND"
processing_command = "BRE.EXE PLANETARY /DETAILED"
scores_command = "BRE.EXE SCORES"
completion_marker = "Planetary Maintenance Complete"

[dosemu.555.fe]
game_folder = "/home/novahub/.dosemu/drive_c/bbs/doors/fe_555"
game_dos_path = "C:\\bbs\\doors\\fe_555"
inbound_folder = "/home/novahub/.dosemu/drive_c/bbs/doors/fe_555/INBOUND"
outbound_folder = "/home/novahub/.dosemu/drive_c/bbs/doors/fe_555/OUTBOUND"
processing_command = "FE.EXE PLANETARY /DETAILED"
scores_command = "FE.EXE SCORES"

# Immortal Barons leagues (game letter I) run a native binary, not dosemu, so
# they have their own section, keyed by league number. The hub is the league's
# Coordinator, node 1: [hub] bbs_index must be 01.
#
# binary and data_dir are required. inbound_dir and outbound_dir default to the
# game's own, inbound/ and outbound/ inside data_dir; set them to what the hub's
# bbs.cfg gives for GameInbound and GameOutbound. args defaults to ["-maint"];
# "-data <data_dir>" is always added. timeout defaults to [dosemu] timeout.
#
# hub_board_key is the public half of the hub's signing key (64 hex characters),
# written into the roster as node 1's seventh line. Members' keys are set per
# member in the league's page. The roster is written to data_dir/ibnodes.dat,
# and published to members as IBNODES.<league>.
#
# IB never reuses a packet name, so the hub deletes its IB packet files after
# [processing] retention_days, as it does logs; sequence gaps are not checked.
#[ib.555]
#binary = "/opt/immortal-barons/immortal-barons"
#data_dir = "/home/novahub/ib_555"
#hub_board_key = "<64 hex characters>"

[database]
path = "./data/nova-hub.db"

[security]
# REQUIRED: Generate with: python generate_jwt_secret.py
# Application will refuse to start if this is set to the default value.
jwt_secret = "change-me-in-production"
jwt_expiry_hours = 24
# Maximum packet upload size in bytes (default: 10 MB)
max_upload_size_bytes = 10485760
# Minimum password length for management users (default: 12)
min_password_length = 12
# Set cookie_secure = true when serving over HTTPS (recommended for production)
cookie_secure = true
# The reverse proxy's address. Only requests from these peers have their
# X-Forwarded-For/-Host/-Proto believed (for rate limits, audit IPs and links).
# trusted_proxies = ["127.0.0.1", "::1"]

[identity]
# Sysop sign-in through WorkOS AuthKit. Leave provider empty to keep only the
# local username/password login (which stays as a break-glass either way).
# The sign-in callback is <server.public_url>/management/api/v1/auth/sso/callback,
# and must be listed as a redirect URI in the WorkOS dashboard.
provider = ""
# client_id = "client_..."
# api_key = "sk_..."

[rate_limiting]
enabled = true
# Maximum authentication attempts per minute per IP before lockout
auth_attempts_per_minute = 10
# Lockout duration in seconds after exceeding auth_attempts_per_minute
auth_lockout_seconds = 300

# ─── Out-of-band alert delivery ───────────────────────────────────────────────
# Alerts are fired when sequence gaps are detected (missing packets).
# Both channels can be enabled simultaneously.
[alerting]
enabled = false

[alerting.email]
enabled = false
smtp_host = "smtp.example.com"
smtp_port = 587
smtp_user = ""
smtp_password = ""
from_address = "nova-hub@example.com"
to_addresses = ["admin@example.com"]
use_tls = true
# SMTP connect/send timeout in seconds
timeout = 10

[alerting.webhook]
enabled = false
url = "https://hooks.example.com/nova-hub-alerts"
# Optional HMAC-SHA256 signing secret.  Requests will include an
# X-Nova-Hub-Signature: sha256=<hex> header.  Leave empty to disable signing.
secret = ""
timeout_seconds = 10
retry_attempts = 3
