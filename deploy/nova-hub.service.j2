[Unit]
Description=Nova Hub - BBS Inter-League Routing System
After=network.target

[Service]
Type=simple
User={{ nova_hub_user }}
Group={{ nova_hub_group }}
WorkingDirectory={{ nova_hub_dir }}
ExecStart={{ nova_hub_dir }}/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Environment
Environment=PYTHONUNBUFFERED=1

# Sandboxing that needs no list of what the hub writes. Not ProtectSystem=strict:
# that makes /home read-only too, and every league's game_folder (anywhere the
# config says) would have to be listed in ReadWritePaths, or its processing
# fails. Neither dosemu nor script is setuid, so NoNewPrivileges costs nothing.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# Packets, transcripts, backups and the database are the hub's alone.
UMask=0077

[Install]
WantedBy=multi-user.target
